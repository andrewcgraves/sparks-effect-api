PORT=8080

# RabbitMQ connection string for the routing queue. The API no longer computes
# isochrones — it publishes them for the routing worker, which runs beside
# Valhalla inside the home cluster. When unset the isochrone endpoints answer
# 503, so local dev works without a broker.
AMQP_URL=

# Queue routing jobs are published to. Must match what the worker consumes from.
# Defaults to routing.jobs; leave unset unless both sides are being changed.
ROUTING_QUEUE=

# Postgres connection string. On Railway this is injected as DATABASE_URL via the
# private-network endpoint. When unset, the server falls back to the read-only
# embedded YAML store so local dev works without a database.
DATABASE_URL=

# Optional cap on the pgx connection pool size (>0 to override pgx's default).
DATABASE_MAX_CONNS=

# Shared bearer token the routing worker presents on /api/internal/... (SPA-273).
# Must match WORKER_TOKEN on the worker. When unset those routes answer 503
# rather than being left unauthenticated.
WORKER_TOKEN=

# How long a session token stays valid after login. Defaults to 24 hours.
SESSION_TTL_HOURS=

# Provisions the first admin account on boot. The API is invite-only — there is
# no signup route — so without this there is no way to create the account that
# creates all other accounts. Applied only when the email does not already
# exist: it never overwrites or resets an existing account's password.
# Both must be set for it to take effect. Authentication requires DATABASE_URL;
# without a database the auth endpoints answer 503.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Every log line is a single JSON object (timestamp, level, message, and
# structured fields) written to stderr, so it can be forwarded to Grafana
# through Alloy without scraping free text.
#
# LOG_LEVEL sets the minimum level logged: debug, info, warn, or error
# (case-insensitive). Unset or unrecognised defaults to info. VERBOSE=true is
# a back-compat alias for LOG_LEVEL=debug.
#
# At debug level the server additionally logs each isochrone request's
# parameters, each routing job as it is published, and when a seeded scenario
# compile is skipped because it is already compiled.
LOG_LEVEL=

# Set ALLOW_LOCALHOST_CORS=true to allow CORS requests from localhost origins
# (e.g. http://localhost:5173, http://127.0.0.1:4173) during local SPA testing.
# Off by default — do not enable in production.
ALLOW_LOCALHOST_CORS=

# Global boarding-wait policy baked into every compiled ServiceGraph.WaitSecs
# at compile time (SPA-236). none (default) charges no platform wait;
# half_headway charges min(headway)/2; full_headway charges min(headway);
# fixed charges BOARDING_WAIT_FIXED_SECS (≥ 0), which is read only under that
# policy — a leftover seconds value next to half_headway is ignored.
# Per-service and per-scenario overrides (SPA-237) win over this default;
# unset still means inherit, so changing this still moves everything that
# has not opted out.
# Malformed or incomplete values fall back to none rather than failing the
# boot, so the worst a typo can do is charge no wait instead of a wrong one.
BOARDING_WAIT_POLICY=
BOARDING_WAIT_FIXED_SECS=
